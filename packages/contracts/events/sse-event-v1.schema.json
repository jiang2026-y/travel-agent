{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://travel-agent.local/contracts/events/sse-event-v1.schema.json",
  "title": "旅行助手事件存储与 SSE data v1",
  "description": "事件存储对象的 data 是单个事件数据体。浏览器 SSE 线格式为 event:type、id:stream_id、data:序列化后的 data；不会把完整存储对象作为 data 发送。禁止包含认证凭据、提示词或思维链。",
  "type": "object",
  "additionalProperties": false,
  "required": ["event_id", "run_id", "timestamp", "type", "data", "trace_id"],
  "properties": {
    "event_id": { "$ref": "#/$defs/Identifier" },
    "stream_id": { "$ref": "#/$defs/Identifier" },
    "run_id": { "$ref": "#/$defs/Identifier" },
    "timestamp": { "type": "string", "format": "date-time" },
    "type": {
      "enum": [
        "run_started",
        "intent_recognized",
        "progress",
        "token",
        "clarification_required",
        "tool_status",
        "plan_proposed",
        "approval_required",
        "recommendations",
        "assistant_message",
        "intent_recognition",
        "query_rewrite",
        "route_selected",
        "master_started",
        "master_completed",
        "sub_agent_started",
        "sub_agent_completed",
        "tool_summary",
        "run_error",
        "recommendation_started",
        "recommendation_completed",
        "knowledge_search_started",
        "knowledge_search_completed",
        "knowledge_search_failed",
        "conversation_title",
        "interrupted",
        "token_usage",
        "tool_started",
        "tool_completed",
        "result_card",
        "error",
        "run_completed"
      ]
    },
    "data": { "type": "object" },
    "trace_id": { "$ref": "#/$defs/Identifier" }
  },
  "allOf": [
    { "if": { "properties": { "type": { "const": "run_started" } } }, "then": { "properties": { "data": { "$ref": "#/$defs/RunStarted" } } } },
    { "if": { "properties": { "type": { "const": "intent_recognized" } } }, "then": { "properties": { "data": { "$ref": "#/$defs/IntentRecognized" } } } },
    { "if": { "properties": { "type": { "const": "progress" } } }, "then": { "properties": { "data": { "$ref": "#/$defs/Progress" } } } },
    { "if": { "properties": { "type": { "const": "token" } } }, "then": { "properties": { "data": { "$ref": "#/$defs/Token" } } } },
    { "if": { "properties": { "type": { "const": "clarification_required" } } }, "then": { "properties": { "data": { "$ref": "#/$defs/Clarification" } } } },
    { "if": { "properties": { "type": { "const": "tool_status" } } }, "then": { "properties": { "data": { "$ref": "#/$defs/ToolStatus" } } } },
    { "if": { "properties": { "type": { "const": "plan_proposed" } } }, "then": { "properties": { "data": { "$ref": "#/$defs/PlanProposed" } } } },
    { "if": { "properties": { "type": { "const": "approval_required" } } }, "then": { "properties": { "data": { "$ref": "#/$defs/ApprovalRequired" } } } },
    { "if": { "properties": { "type": { "const": "recommendations" } } }, "then": { "properties": { "data": { "$ref": "#/$defs/Recommendations" } } } },
    { "if": { "properties": { "type": { "const": "assistant_message" } } }, "then": { "properties": { "data": { "$ref": "#/$defs/AssistantMessage" } } } },
    { "if": { "properties": { "type": { "const": "error" } } }, "then": { "properties": { "data": { "$ref": "#/$defs/Error" } } } },
    { "if": { "properties": { "type": { "const": "run_completed" } } }, "then": { "properties": { "data": { "$ref": "#/$defs/RunCompleted" } } } }
    ,{ "if": { "properties": { "type": { "const": "knowledge_search_started" } } }, "then": { "properties": { "data": { "$ref": "#/$defs/KnowledgeSearchStarted" } } } }
    ,{ "if": { "properties": { "type": { "const": "knowledge_search_completed" } } }, "then": { "properties": { "data": { "$ref": "#/$defs/KnowledgeSearchCompleted" } } } }
    ,{ "if": { "properties": { "type": { "const": "knowledge_search_failed" } } }, "then": { "properties": { "data": { "$ref": "#/$defs/KnowledgeSearchFailed" } } } }
    ,{ "if": { "properties": { "type": { "const": "conversation_title" } } }, "then": { "properties": { "data": { "$ref": "#/$defs/ConversationTitle" } } } }
    ,{ "if": { "properties": { "type": { "const": "interrupted" } } }, "then": { "properties": { "data": { "$ref": "#/$defs/Interrupted" } } } }
    ,{ "if": { "properties": { "type": { "const": "token_usage" } } }, "then": { "properties": { "data": { "$ref": "#/$defs/TokenUsage" } } } }
    ,{ "if": { "properties": { "type": { "const": "tool_started" } } }, "then": { "properties": { "data": { "$ref": "#/$defs/ToolProgressStarted" } } } }
    ,{ "if": { "properties": { "type": { "const": "tool_completed" } } }, "then": { "properties": { "data": { "$ref": "#/$defs/ToolProgressCompleted" } } } }
    ,{ "if": { "properties": { "type": { "const": "result_card" } } }, "then": { "properties": { "data": { "$ref": "#/$defs/ResultCard" } } } }
  ],
  "$defs": {
    "Identifier": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,128}$" },
    "RunStarted": { "type": "object", "additionalProperties": false, "required": ["conversation_id", "status"], "properties": { "conversation_id": { "$ref": "#/$defs/Identifier" }, "status": { "type": "string", "minLength": 1, "maxLength": 64 } } },
    "IntentRecognized": { "type": "object", "additionalProperties": false, "required": ["source", "intent_summary", "confidence", "missing_slots"], "properties": { "source": { "enum": ["L0", "RULE", "VECTOR", "LLM"] }, "intent_summary": { "type": "string", "minLength": 1, "maxLength": 500 }, "confidence": { "type": "number", "minimum": 0, "maximum": 1 }, "missing_slots": { "type": "array", "maxItems": 20, "items": { "type": "string", "maxLength": 100 } } } },
    "Progress": { "type": "object", "additionalProperties": false, "required": ["stage_code", "message"], "properties": { "stage_code": { "type": "string", "pattern": "^[A-Z0-9_]{1,64}$" }, "message": { "type": "string", "minLength": 1, "maxLength": 500 } } },
    "Token": { "type": "object", "additionalProperties": false, "required": ["text"], "properties": { "text": { "type": "string", "minLength": 1, "maxLength": 4000 } } },
    "Clarification": { "type": "object", "additionalProperties": false, "required": ["questions", "reason"], "properties": { "questions": { "type": "array", "minItems": 1, "maxItems": 3, "items": { "type": "string", "minLength": 1, "maxLength": 500 } }, "reason": { "type": "string", "minLength": 1, "maxLength": 500 } } },
    "ToolStatus": { "type": "object", "additionalProperties": false, "required": ["skill_name", "status", "summary"], "properties": { "skill_name": { "type": "string", "maxLength": 100 }, "status": { "enum": ["started", "completed", "failed", "denied"] }, "summary": { "type": "string", "maxLength": 500 } } },
    "PlanProposed": { "type": "object", "additionalProperties": false, "required": ["plan_id", "options", "assumptions"], "properties": { "plan_id": { "$ref": "#/$defs/Identifier" }, "options": { "type": "array", "maxItems": 10, "items": { "type": "object" } }, "assumptions": { "type": "array", "maxItems": 20, "items": { "type": "string", "maxLength": 500 } } } },
    "ApprovalRequired": { "type": "object", "additionalProperties": false, "required": ["action_summary", "allowed_decisions"], "properties": { "action_summary": { "type": "string", "maxLength": 500 }, "allowed_decisions": { "type": "array", "minItems": 1, "maxItems": 4, "items": { "enum": ["approve", "reject", "edit", "timeout"] } } } },
    "Recommendations": { "type": "object", "additionalProperties": false, "required": ["items"], "properties": { "items": { "type": "array", "maxItems": 10, "items": { "type": "string", "maxLength": 500 } } } },
    "AssistantMessage": { "type": "object", "additionalProperties": false, "required": ["content"], "properties": { "content": { "type": "string", "minLength": 1, "maxLength": 16000 } } },
    "Error": { "type": "object", "additionalProperties": false, "required": ["code", "message", "retryable"], "properties": { "code": { "type": "string", "pattern": "^[a-z0-9_]{1,100}$" }, "message": { "type": "string", "maxLength": 500 }, "retryable": { "type": "boolean" } } },
    "RunCompleted": { "type": "object", "additionalProperties": false, "required": ["status", "result_ref"], "properties": { "status": { "enum": ["completed", "cancelled", "failed"] }, "result_ref": { "$ref": "#/$defs/Identifier" } } }
    ,"KnowledgeSearchStarted": { "type": "object", "additionalProperties": false, "required": ["status"], "properties": { "status": { "const": "running" } } }
    ,"KnowledgeSearchCompleted": { "type": "object", "additionalProperties": false, "required": ["status", "count", "duration_ms"], "properties": { "status": { "enum": ["completed", "empty"] }, "count": { "type": "integer", "minimum": 0, "maximum": 8 }, "duration_ms": { "type": "integer", "minimum": 0 }, "sources": { "type": "array", "maxItems": 8, "items": { "type": "string", "maxLength": 200 } } } }
    ,"TokenUsage": { "type": "object", "additionalProperties": false, "required": ["input_tokens", "output_tokens", "total_tokens", "model_calls"], "properties": { "input_tokens": { "type": "integer", "minimum": 0 }, "output_tokens": { "type": "integer", "minimum": 0 }, "total_tokens": { "type": "integer", "minimum": 0 }, "model_calls": { "type": "integer", "minimum": 0 } } }
    ,"ToolProgressStarted": { "type": "object", "additionalProperties": false, "required": ["agent", "tool"], "properties": { "agent": { "type": "string", "maxLength": 64 }, "tool": { "type": "string", "maxLength": 64 } } }
    ,"ToolProgressCompleted": { "type": "object", "additionalProperties": false, "required": ["agent", "tool", "status", "duration_ms"], "properties": { "agent": { "type": "string", "maxLength": 64 }, "tool": { "type": "string", "maxLength": 64 }, "status": { "enum": ["completed", "failed"] }, "duration_ms": { "type": "integer", "minimum": 0 } } }
    ,"ResultCard": { "type": "object", "additionalProperties": false, "required": ["kind", "title", "source", "count", "items"], "properties": { "kind": { "enum": ["flight", "train", "hotel"] }, "title": { "type": "string", "maxLength": 64 }, "source": { "type": "string", "maxLength": 32 }, "count": { "type": "integer", "minimum": 0, "maximum": 5 }, "items": { "type": "array", "maxItems": 5, "items": { "type": "object", "additionalProperties": false, "required": ["code"], "properties": { "code": { "type": "string", "maxLength": 128 }, "airline": { "type": "string", "maxLength": 64 }, "fromStation": { "type": "string", "maxLength": 128 }, "toStation": { "type": "string", "maxLength": 128 }, "departureTime": { "type": "string", "maxLength": 32 }, "arrivalTime": { "type": "string", "maxLength": 32 }, "duration": { "type": "string", "maxLength": 32 }, "cabin": { "type": "string", "maxLength": 64 }, "seats": { "type": "string", "maxLength": 32 }, "transport": { "type": "string", "maxLength": 32 }, "detail": { "type": "string", "maxLength": 200 }, "price": { "type": "string", "maxLength": 32 }, "priceLabel": { "type": "string", "maxLength": 8 } } } } } }
    ,"KnowledgeSearchFailed": { "type": "object", "additionalProperties": false, "required": ["status", "error_code"], "properties": { "status": { "const": "failed" }, "error_code": { "type": "string", "pattern": "^[a-z0-9_]{1,100}$" } } }
    ,"ConversationTitle": { "type": "object", "additionalProperties": false, "required": ["title"], "properties": { "title": { "type": "string", "minLength": 1, "maxLength": 64 } } }
    ,"Interrupted": { "type": "object", "additionalProperties": false, "required": ["status"], "properties": { "status": { "const": "cancelled" }, "reason": { "type": "string", "maxLength": 64 } } }
  }
}

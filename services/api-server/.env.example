# API Server 本地真实只读运行基线；不得填写真实短信、数据库或服务身份凭据。
TRAVEL_AGENT_ENV=development
TRAVEL_AGENT_EXTERNAL_MODE=real_readonly
API_SERVER_PORT=8000
AGENT_SERVER_BASE_URL=http://agent-server:8001
# Docker Secret 挂载路径；只填写文件路径，严禁在环境变量中写入 Token 明文。
API_AGENT_INTERNAL_TOKEN_FILE=/run/secrets/api_agent_internal_token
TRAVEL_AGENT_CORS_ALLOWED_ORIGINS=http://localhost:5173
TRAVEL_AGENT_SESSION_COOKIE_NAME=travel_agent_session
TRAVEL_AGENT_COOKIE_SECURE=false
TRAVEL_AGENT_COOKIE_SAMESITE=lax
TRAVEL_AGENT_CSRF_COOKIE_NAME=travel_agent_csrf
TRAVEL_AGENT_CSRF_HEADER_NAME=X-CSRF-Token
TRAVEL_AGENT_CSRF_ENABLED=true
TRAVEL_AGENT_PRIVACY_FEATURES_ENABLED=true
# P0 本地会话与登录失败限流基线；生产值须在 G2/G8 评审后显式确认。
TRAVEL_AGENT_SESSION_TTL_SECONDS=28800
TRAVEL_AGENT_LOGIN_FAILURE_LIMIT=5
TRAVEL_AGENT_LOGIN_FAILURE_WINDOW_SECONDS=900
# Provider 未完成 G3/G5 审批前保持空值和 false；不得填写真实密钥。
TRAVEL_AGENT_PROVIDER_KEY=
TRAVEL_AGENT_PROVIDER_VERSION=
TRAVEL_AGENT_PROVIDER_BASE_URL=
TRAVEL_AGENT_PROVIDER_SECRET_REF=
TRAVEL_AGENT_PROVIDER_APPROVED=false
# PostgreSQL 运行与迁移连接；本地 Compose 会覆盖为服务名和 Docker Secret。
DATABASE_URL=postgresql+asyncpg://travel_agent_dev:local_development_only@localhost:5432/travel_agent_dev
DATABASE_MIGRATION_URL=postgresql+psycopg://travel_agent_dev:local_development_only@localhost:5432/travel_agent_dev
TRAVEL_AGENT_DATA_ENCRYPTION_KEY_FILE=.secrets/data_encryption_key
TRAVEL_AGENT_PERSISTENCE_ENABLED=false

# Agent Server 本地真实只读运行基线；不得填写真实百炼、记忆库、知识库或 Skill 凭据。
TRAVEL_AGENT_ENV=development
TRAVEL_AGENT_EXTERNAL_MODE=real_readonly
AGENT_SERVER_PORT=8001
TOOL_GATEWAY_BASE_URL=http://tool-gateway:8002
# Docker Secret 挂载路径；只填写文件路径，严禁在环境变量中写入 Token 明文。
API_AGENT_INTERNAL_TOKEN_FILE=/run/secrets/api_agent_internal_token
TRAVEL_AGENT_PRIVACY_FEATURES_ENABLED=true
# Provider 未完成 G3/G5 审批前保持空值和 false；不得填写真实密钥。
TRAVEL_AGENT_PROVIDER_KEY=
TRAVEL_AGENT_PROVIDER_VERSION=
TRAVEL_AGENT_PROVIDER_BASE_URL=
TRAVEL_AGENT_PROVIDER_SECRET_REF=
TRAVEL_AGENT_PROVIDER_APPROVED=false

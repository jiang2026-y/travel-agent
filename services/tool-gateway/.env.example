# Tool Gateway 本地真实只读运行基线；不登记 Provider，不填写真实凭据或域名。
TRAVEL_AGENT_ENV=development
TRAVEL_AGENT_EXTERNAL_MODE=real_readonly
TOOL_GATEWAY_PORT=8002
BAILIAN_ENABLED=false
BAILIAN_WORKSPACE_ID=
BAILIAN_INDEX_ID=
BAILIAN_ACCESS_KEY_ID_FILE=/run/secrets/bailian_access_key_id
BAILIAN_ACCESS_KEY_SECRET_FILE=/run/secrets/bailian_access_key_secret
